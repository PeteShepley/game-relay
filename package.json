{
  "name": "@peteshepley/game-relay",
  "version": "0.0.0",
  "private": true,
  "description": "Shared WebSocket relay for peteshepley.com multiplayer games: the room sequencer (API Gateway WebSocket + Lambda).",
  "license": "ISC",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeteShepley/game-relay.git"
  },
  "exports": {
    "./protocol": "./src/protocol.ts"
  },
  "files": [
    "src/protocol.ts"
  ],
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node22 --external:@aws-sdk/* --outfile=dist/index.js",
    "dev:local": "tsx src/local.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.5.12",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "ws": "^8.18.0"
  }
}
